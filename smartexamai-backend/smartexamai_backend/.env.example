# --- Base de données ---
SMARTEXAM_DATABASE_URL=sqlite:///smartexamai.db
SMARTEXAM_ECHO_SQL=false

# --- Stockage des fichiers ---
SMARTEXAM_STORAGE_ROOT=./storage_data
SMARTEXAM_PIPELINE_ROOT=..
SMARTEXAM_PIPELINE_WORK_ROOT=../pipeline_work

# --- Clés API (pipeline IA : correction rédaction / code via LLM) ---
API_KEY=
OPENROUTER_API_KEY=

# --- Sécurité mots de passe ---
SMARTEXAM_PBKDF2_ITERATIONS=260000

# --- JWT (authentification API) ---
SMARTEXAM_JWT_SECRET=change-me-in-production
SMARTEXAM_JWT_EXPIRE_MINUTES=480

# --- CORS : origines autorisées pour le frontend React (séparées par des virgules) ---
SMARTEXAM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Sandbox Docker (correction de code) ---
DOCKER_IMAGE_PYTHON=python:3.11-slim
DOCKER_IMAGE_PHP=php:8.2-cli
DOCKER_IMAGE_JAVA=openjdk:17-slim
DOCKER_IMAGE_C=gcc:latest
DOCKER_TIMEOUT=10
DOCKER_MEMORY_LIMIT=256m
DOCKER_MAX_OUTPUT_SIZE=1048576
